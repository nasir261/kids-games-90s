@@ -0,0 +1,42 @@
+name: Build Cozy Brick Blast
+
+on:
+  workflow_dispatch:
+  pull_request:
+    paths:
+      - 'BrickBlast/**'
+      - '.github/workflows/build-cozy-brick-blast.yml'
+  push:
+    branches:
+      - main
+      - rename-sleepy-to-cozy
+      - 'codex/**'
+    paths:
+      - 'BrickBlast/**'
+      - '.github/workflows/build-cozy-brick-blast.yml'
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: macos-latest
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Select latest Xcode
+        run: sudo xcode-select -s /Applications/Xcode.app
+
+      - name: Build standalone app for iOS Simulator
+        run: |
+          xcodebuild \
+            -project BrickBlast/BrickBlast.xcodeproj \
+            -scheme BrickBlast \
+            -configuration Debug \
+            -sdk iphonesimulator \
+            -destination 'generic/platform=iOS Simulator' \
+            -derivedDataPath build/BrickBlast \
+            CODE_SIGNING_ALLOWED=NO \
+            build
